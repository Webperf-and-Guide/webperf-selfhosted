{
  "name": "webperf-executor",
  "description": "Durable self-host execution worker for probes, webhooks, and Browser Audits",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@webperf/config": "workspace:*",
    "@webperf/contracts": "workspace:*",
    "@webperf/domain-core": "workspace:*",
    "@webperf/report-core": "workspace:*"
  }
}
