WEBPERF_VERSION=0.2.1

SELFHOST_REGION_ID=local
SELFHOST_REGION_LABEL=Local regional runtime
REGIONAL_RUNTIME_PUBLIC_PORT=8788

SELFHOST_INTERNAL_SECRET=replace-with-a-random-internal-secret
SELFHOST_INTERNAL_SECRET_NEXT=
REGIONAL_RUNTIME_SHARED_SECRET=replace-with-a-random-regional-runtime-secret
REGIONAL_RUNTIME_SHARED_SECRET_NEXT=
PROBE_SHARED_SECRET=replace-with-a-random-probe-secret
PROBE_SHARED_SECRET_NEXT=

# Populate these from the same immutable GitHub Release runtime-metadata.json
# used to select the image references. They are optional for local development
# but required for production provenance.
WEBPERF_RUNTIME_IMAGE_DIGEST=
WEBPERF_PROBE_IMAGE_DIGEST=

# Optional resource and log limits.
# WEBPERF_LOG_MAX_SIZE=10m
# WEBPERF_LOG_MAX_FILES=3
# REGIONAL_API_CPU_LIMIT=1.00
# REGIONAL_API_MEMORY_LIMIT=512M
# REGIONAL_EXECUTOR_CPU_LIMIT=1.00
# REGIONAL_EXECUTOR_MEMORY_LIMIT=384M
# REGIONAL_PROBE_CPU_LIMIT=1.00
# REGIONAL_PROBE_MEMORY_LIMIT=256M
