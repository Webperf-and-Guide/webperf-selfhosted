# Phase 2 of issue #14: single multi-role Bun image for the self-host product.
# This Dockerfile ships console, API, executor, and scheduler in one image.
# The default standalone role supervises console, API, and executor in one
# container; split roles remain available for development and maintenance.
#
# Build context: repository root (same as the four legacy Dockerfiles).

# --- Stage 1: build console's SvelteKit output ---
FROM oven/bun:1.3.13 AS build

WORKDIR /app

COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/package.json
COPY apps/console/package.json apps/console/package.json
COPY apps/scheduler/package.json apps/scheduler/package.json
COPY apps/executor/package.json apps/executor/package.json
COPY apps/browser-audit-lighthouse/package.json apps/browser-audit-lighthouse/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/domain-core/package.json packages/domain-core/package.json
COPY packages/report-core/package.json packages/report-core/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN bun install --frozen-lockfile

COPY . .

# Console is the only app that needs a build step (vite → SvelteKit adapter-node).
# Run svelte-kit sync first because .dockerignore excludes **/.svelte-kit and
# bun install's prepare hook ran before the source was copied.
RUN bun run --cwd apps/console prepare && bun run --cwd apps/console build

# --- Stage 2: runtime ---
FROM oven/bun:1.3.13

WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0

COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/package.json
COPY apps/console/package.json apps/console/package.json
COPY apps/scheduler/package.json apps/scheduler/package.json
COPY apps/executor/package.json apps/executor/package.json
COPY apps/browser-audit-lighthouse/package.json apps/browser-audit-lighthouse/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/domain-core/package.json packages/domain-core/package.json
COPY packages/report-core/package.json packages/report-core/package.json
COPY packages/ui/package.json packages/ui/package.json

# Wait for the build stage before starting a second Bun install. Running the
# two package extractions concurrently has caused intermittent native-package
# tarball failures under BuildKit.
COPY --from=build /app/apps/console/build/index.js /tmp/webperf-console-build-ready

RUN test -s /tmp/webperf-console-build-ready \
  && bun install --frozen-lockfile --production --no-save \
  --filter=webperf-api \
  --filter=webperf-console \
  --filter=webperf-scheduler \
  --filter=webperf-executor \
  && rm /tmp/webperf-console-build-ready

# Copy source and the console build output from the build stage.
COPY --chown=bun:bun --from=build /app/apps/api ./apps/api
COPY --chown=bun:bun --from=build /app/apps/console ./apps/console
COPY --chown=bun:bun --from=build /app/apps/scheduler ./apps/scheduler
COPY --chown=bun:bun --from=build /app/apps/executor ./apps/executor
COPY --chown=bun:bun --from=build /app/packages ./packages
COPY --chown=bun:bun --from=build /app/tooling ./tooling
COPY --chown=bun:bun --from=build /app/infra ./infra

# /data is the persistence volume mount point for the API role.
RUN mkdir -p /data && chown bun:bun /data

USER bun

# The role dispatcher reads WEBPERF_ROLE and execs into the right entrypoint.
ENTRYPOINT ["bun", "run", "tooling/scripts/webperf-role.ts"]
