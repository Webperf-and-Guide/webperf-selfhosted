{
  "name": "webperf-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "build:selfhost": "bun run build",
    "preview": "bunx --bun vite preview",
    "start": "bun ./build/index.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:ui-package": "svelte-check --tsconfig ../../packages/ui/tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@sveltejs/kit": "^2.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/bun": "^1.3.11",
    "svelte": "^5.55.1",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.1.18",
    "typescript": "7.0.2",
    "vite": "^8.0.5"
  },
  "dependencies": {
    "@orpc/client": "^1.13.14",
    "@orpc/contract": "^1.13.14",
    "@sveltejs/adapter-node": "^5.3.1",
    "@tanstack/svelte-query": "^6.1.16",
    "@webperf/contracts": "workspace:*",
    "@webperf/domain-core": "workspace:*",
    "@webperf/config": "workspace:*",
    "@webperf/report-core": "workspace:*",
    "@webperf/ui": "workspace:*"
  }
}
