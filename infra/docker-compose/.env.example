WEBPERF_VERSION=0.3.0

CONTROL_BASE_URL=http://api:8788
SELFHOST_ADMIN_TOKEN=replace-with-a-random-admin-token
SELFHOST_ADMIN_TOKEN_NEXT=
SELFHOST_INTERNAL_SECRET=replace-with-a-random-internal-secret
SELFHOST_INTERNAL_SECRET_NEXT=
CONSOLE_ORIGIN=http://localhost:5173
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=3000
CONSOLE_PUBLIC_PORT=5173
SELFHOST_API_DEBUG_PORT=8788
BROWSER_AUDIT_DEBUG_PORT=8081

PROBE_SHARED_SECRET=replace-with-a-long-random-shared-secret
PROBE_SHARED_SECRET_NEXT=
BROWSER_AUDIT_SHARED_SECRET=replace-with-a-random-browser-secret
BROWSER_AUDIT_SHARED_SECRET_NEXT=
BROWSER_AUDIT_ALLOW_NO_SANDBOX=false
SELFHOST_BROWSER_AUDIT_BASE_URL=
SELFHOST_EXECUTOR_ALLOW_INSECURE_API_HTTP=true
SELFHOST_EXECUTOR_ALLOW_INSECURE_BROWSER_AUDIT_HTTP=true
SELFHOST_EXECUTOR_ALLOW_INSECURE_WEBHOOK_HTTP=false

SELFHOST_API_HOST=0.0.0.0
SELFHOST_API_PORT=8788
SELFHOST_DATABASE_PATH=/data/webperf.sqlite
SELFHOST_ARTIFACTS_PATH=/data/artifacts
SELFHOST_ARTIFACT_UPLOAD_BASE_URL=http://api:8788
SELFHOST_MAX_ARTIFACT_BYTES=25000000
SELFHOST_ARTIFACT_UPLOAD_TTL_SECONDS=900
SELFHOST_RETENTION_DAYS=30
SELFHOST_MIGRATION_BACKUP=false
SELFHOST_REGION_ID=local
SELFHOST_REGION_LABEL=
SELFHOST_PROBE_BASE_URL=http://probe:8080
SELFHOST_EXECUTOR_ALLOW_INSECURE_PROBE_HTTP=true
SELFHOST_MAX_TARGET_ATTEMPTS=3
SELFHOST_SCHEDULER_API_BASE_URL=http://api:8788
SELFHOST_SCHEDULER_POLL_INTERVAL_SECONDS=60

# Optional resource and log limits. The defaults in compose.yml suit a small
# single-organization installation; uncomment only when tuning the host.
# WEBPERF_LOG_MAX_SIZE=10m
# WEBPERF_LOG_MAX_FILES=3
# CONSOLE_CPU_LIMIT=0.50
# CONSOLE_MEMORY_LIMIT=256M
# API_CPU_LIMIT=1.00
# API_MEMORY_LIMIT=1G
# SCHEDULER_CPU_LIMIT=0.25
# SCHEDULER_MEMORY_LIMIT=128M
# EXECUTOR_CPU_LIMIT=1.00
# EXECUTOR_MEMORY_LIMIT=512M
# PROBE_CPU_LIMIT=1.00
# PROBE_MEMORY_LIMIT=256M
# BROWSER_AUDIT_CPU_LIMIT=2.00
# BROWSER_AUDIT_MEMORY_LIMIT=2G
