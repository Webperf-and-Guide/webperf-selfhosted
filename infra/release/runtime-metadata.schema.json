{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webperf.and.guide/schemas/selfhost-release-runtime-metadata-v2.json",
  "title": "WebPerf self-host release runtime metadata",
  "description": "v2 schema for the consolidated three-image runtime model. v1 (six images) is preserved as an immutable frozen schema at ...-v1.json and must not be modified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "tag", "sourceCommit", "platform", "images"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "version": { "type": "string", "pattern": "^0\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|(?=[0-9A-Za-z-]*[A-Za-z-])[0-9A-Za-z-]+)(?:\\.(?:0|[1-9][0-9]*|(?=[0-9A-Za-z-]*[A-Za-z-])[0-9A-Za-z-]+))*)?$" },
    "tag": { "type": "string", "pattern": "^v0\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|(?=[0-9A-Za-z-]*[A-Za-z-])[0-9A-Za-z-]+)(?:\\.(?:0|[1-9][0-9]*|(?=[0-9A-Za-z-]*[A-Za-z-])[0-9A-Za-z-]+))*)?$" },
    "sourceCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "platform": {
      "const": "linux/amd64",
      "description": "The v1 amd64 compatibility baseline. The immutable digest can name a multi-platform OCI index; resolve supported platforms from that registry manifest."
    },
    "images": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "properties": { "name": { "const": "webperf" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "probe" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "browser-audit-lighthouse" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image", "tag", "digest", "reference", "platform", "sbom"],
        "properties": {
          "name": {
            "enum": ["webperf", "probe", "browser-audit-lighthouse"]
          },
          "image": { "type": "string", "pattern": "^ghcr\\.io/webperf-and-guide/webperf(?:-[a-z-]+)?$" },
          "tag": { "type": "string", "pattern": "^0\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|(?=[0-9A-Za-z-]*[A-Za-z-])[0-9A-Za-z-]+)(?:\\.(?:0|[1-9][0-9]*|(?=[0-9A-Za-z-]*[A-Za-z-])[0-9A-Za-z-]+))*)?$" },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "reference": { "type": "string", "pattern": "^ghcr\\.io/.+@sha256:[a-f0-9]{64}$" },
          "platform": {
            "const": "linux/amd64",
            "description": "The v1 amd64 compatibility baseline. The immutable digest can name a multi-platform OCI index; resolve supported platforms from that registry manifest."
          },
          "sbom": {
            "type": "string",
            "pattern": "^[a-z-]+-[0-9].+\\.spdx\\.json$",
            "description": "The linux/amd64 compatibility SBOM. New multi-platform releases also publish sboms with a matching per-platform digest and file."
          },
          "sboms": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              { "contains": { "properties": { "platform": { "const": "linux/amd64" } }, "required": ["platform"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "platform": { "const": "linux/arm64" } }, "required": ["platform"] }, "minContains": 1, "maxContains": 1 }
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["platform", "digest", "file"],
              "properties": {
                "platform": { "enum": ["linux/amd64", "linux/arm64"] },
                "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "file": { "type": "string", "pattern": "^[a-z-]+-[0-9].+\\.spdx\\.json$" }
              }
            }
          }
        }
      }
    }
  }
}
