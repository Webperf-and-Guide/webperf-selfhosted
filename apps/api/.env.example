SELFHOST_DATABASE_PATH=./data/webperf.sqlite
SELFHOST_RETENTION_DAYS=30
SELFHOST_ADMIN_TOKEN=replace-with-a-random-admin-token
SELFHOST_ADMIN_TOKEN_NEXT=
