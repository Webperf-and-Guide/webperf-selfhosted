{
  "name": "webperf-selfhosted",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash tooling/scripts/dev-all.sh",
    "dev:parallel": "bash tooling/scripts/dev-parallel.sh",
    "dev:browser-audit-lighthouse": "PORT=8081 bun run --cwd apps/browser-audit-lighthouse dev",
    "dev:console": "bash tooling/scripts/dev-console.sh",
    "dev:api": "bash tooling/scripts/dev-api.sh",
    "dev:scheduler": "bun run --cwd apps/scheduler dev",
    "dev:executor": "bun run --cwd apps/executor dev",
    "dev:web": "bun run dev:console",
    "dev:probe": "bash tooling/scripts/dev-probe.sh",
    "build": "bun run --cwd apps/console build",
    "build:browser-audit-lighthouse": "bun run --cwd apps/browser-audit-lighthouse build",
    "check:boundaries": "bun run tooling/scripts/check-boundaries.ts && bun run tooling/scripts/check-retired-paths.ts",
    "check:openapi": "bun run tooling/scripts/check-openapi.ts",
    "check:docs": "bun run tooling/scripts/check-docs.ts",
    "check:release": "bun run tooling/scripts/check-release.ts",
    "check": "bun run check:boundaries && bun run check:openapi && bun run check:release && bun run --cwd apps/console check && bun run --cwd apps/api check && bun run --cwd apps/scheduler check && bun run --cwd apps/executor check && bun run --cwd apps/browser-audit-lighthouse check && bunx tsc -p packages/contracts/tsconfig.json --noEmit && bunx tsc -p packages/domain-core/tsconfig.json --noEmit && bunx tsc -p packages/report-core/tsconfig.json --noEmit && bunx tsc -p packages/config/tsconfig.json --noEmit && bun run --cwd apps/console check:ui-package",
    "test:report-core": "bun test packages/report-core/test/*.test.ts",
    "test": "bun test",
    "test:probe": "cargo test --workspace --manifest-path apps/probe-rs/Cargo.toml",
    "test:integration:recovery": "bun test apps/api/test/restart-recovery.test.ts apps/api/test/http.test.ts packages/domain-core/test/scheduler-loop.test.ts",
    "smoke:console": "bash tooling/scripts/smoke-web.sh",
    "smoke:console:parallel": "SELFHOST_CONSOLE_PORT=${SELFHOST_PARALLEL_CONSOLE_PORT:-4174} bash tooling/scripts/smoke-web.sh",
    "smoke:web": "bun run smoke:console",
    "smoke:compose": "bash tooling/scripts/smoke-compose.sh",
    "smoke:compose:browser-audit": "COMPOSE_PROFILE=browser-audit bash tooling/scripts/smoke-compose.sh",
    "drill:compose:recovery": "bash tooling/scripts/drill-compose-recovery.sh",
    "drill:compose:upgrade": "bash tooling/scripts/drill-compose-upgrade.sh",
    "capture:console:baselines": "bash tooling/scripts/capture-console-baselines.sh",
    "capture:console:baselines:parallel": "BASE_URL=${SELFHOST_PARALLEL_CONSOLE_BASE_URL:-http://localhost:4174} bash tooling/scripts/capture-console-baselines.sh",
    "selfhost:init": "bun tooling/scripts/selfhost-init.ts",
    "selfhost:migrate": "bun tooling/scripts/selfhost-database.ts migrate",
    "selfhost:backup": "bun tooling/scripts/selfhost-database.ts backup",
    "selfhost:restore": "bun tooling/scripts/selfhost-database.ts restore",
    "selfhost:doctor": "bun tooling/scripts/selfhost-database.ts doctor",
    "selfhost:maintenance": "bun tooling/scripts/selfhost-database.ts maintenance",
    "compose:config": "bun tooling/scripts/check-compose.ts && bun tooling/scripts/check-regional-runtime.ts",
    "compose:regional:config": "bun tooling/scripts/check-regional-runtime.ts",
    "smoke:regional-runtime": "bash tooling/scripts/smoke-regional-runtime.sh",
    "ui:normalize-imports": "bun tooling/scripts/normalize-ui-imports.ts",
    "ui:jsrepo:add": "jsrepo add",
    "ui:jsrepo:add:extras": "jsrepo add --cwd packages/ui --registry @ieedan/shadcn-svelte-extras && bun run ui:normalize-imports",
    "ui:jsrepo:update": "jsrepo update --cwd packages/ui && bun run ui:normalize-imports",
    "ui:jsrepo:mcp:codex": "jsrepo config mcp --client codex",
    "sampo:add": "sampo add",
    "sampo:release": "sampo release",
    "sampo:release:dry-run": "sampo release --dry-run",
    "sampo:publish": "sampo publish"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.2",
    "@lucide/svelte": "^1.7.0",
    "@types/bun": "^1.3.11",
    "@webperf/contracts": "workspace:*",
    "@webperf/domain-core": "workspace:*",
    "bits-ui": "^2.16.5",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "jsrepo": "^3.7.0",
    "playwright": "^1.54.2",
    "runed": "^0.37.1",
    "sampo": "0.19.0",
    "shadcn-svelte": "^1.2.7",
    "svelte-toolbelt": "^0.10.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "typescript": "^5.9.3"
  }
}
